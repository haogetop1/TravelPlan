:root{
  --gold:#b08968; --gold-d:#8a6a4f; --gold-l:#d8c3ae; --gold-bg:#f3ece4;
  --cream:#faf7f2; --card:#ffffff; --ink:#2f2a26; --ink-2:#4a423b;
  --muted:#857a70; --line:#e8e0d5; --red:#b23b3b; --green:#5f7a52;
}
*{margin:0;padding:0;box-sizing:border-box}
body{background:#666;font-family:"Microsoft YaHei","PingFang SC",-apple-system,sans-serif}
.slide{
  position:relative;width:1920px;height:1080px;background:var(--cream);
  color:var(--ink);overflow:hidden;margin:0 auto 24px;
}
/* ---------- 页头 ---------- */
.hd{padding:40px 60px 16px;display:flex;align-items:flex-end;gap:18px;
    border-bottom:3px solid var(--gold)}
.hd-num{font-size:20px;font-weight:800;color:var(--gold);letter-spacing:4px}
.hd-t{font-size:44px;font-weight:800;letter-spacing:1px;line-height:1.1}
.hd-en{margin-left:auto;font-size:17px;color:var(--muted);letter-spacing:3px;
       text-transform:uppercase;padding-bottom:6px}
.hd-sub{font-size:19px;color:var(--muted);margin-top:6px;padding-bottom:4px}
.body{padding:24px 60px 40px}
/* ---------- 封面 ---------- */
.cover{width:1920px;height:1080px;position:relative;overflow:hidden;
       background:linear-gradient(160deg,#3a2f26 0%,#241d17 55%,#1b1512 100%)}
.cover-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.86}
.cover-mask{position:absolute;inset:0;background:linear-gradient(180deg,
  rgba(24,18,14,.10) 0%,rgba(24,18,14,.34) 40%,rgba(24,18,14,.78) 70%,rgba(24,18,14,.96) 100%)}
.cover-inner{position:absolute;left:0;right:0;bottom:0;padding:0 96px 78px;color:#fff}
.cover-kicker{display:inline-block;font-size:20px;letter-spacing:6px;padding:10px 22px;
  border-radius:3px;background:rgba(176,137,104,.94);margin-bottom:26px;font-weight:700}
.cover h1{font-size:84px;line-height:1.24;font-weight:800;letter-spacing:2px}
.cover h1 .hl{color:#e8c9a0}
.cover-sub{margin-top:22px;font-size:28px;color:rgba(255,255,255,.9);letter-spacing:2px}
.cover-line{width:110px;height:6px;background:var(--gold);margin:30px 0 26px;border-radius:3px}
.chips{display:flex;flex-wrap:wrap;gap:14px}
.chip{font-size:22px;padding:12px 22px;border-radius:26px;
  background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.26);
  color:rgba(255,255,255,.96)}
/* ---------- 结束页 ---------- */
.end-inner{position:absolute;left:0;right:0;top:0;bottom:0;display:flex;
  flex-direction:column;align-items:center;justify-content:center;
  text-align:center;padding:0 180px;color:#f7f1e8}
.end-kicker{font-size:18px;letter-spacing:14px;color:var(--gold-l);
  margin-bottom:30px;font-weight:700}
.end-title{font-size:78px;font-weight:800;letter-spacing:8px;line-height:1.2;
  text-shadow:0 6px 28px rgba(0,0,0,.5)}
.end-title .hl{color:#e8c9a0}
.end-wish{margin-top:26px;font-size:34px;letter-spacing:9px;color:#ecdfd0;
  text-shadow:0 4px 20px rgba(0,0,0,.45)}
.end-sub{margin-top:30px;font-size:22px;letter-spacing:3px;color:#c9b7a3}
.end-chips{margin-top:46px}
.end-chips .chip{font-size:20px;padding:11px 20px}
/* ---------- 通用卡 ---------- */
.card{background:var(--card);border:1px solid var(--line);border-radius:16px;overflow:hidden}
.card-h{padding:14px 20px;background:var(--gold-bg);border-bottom:1px solid var(--line);
  font-size:22px;font-weight:800;display:flex;align-items:center;gap:10px;color:var(--ink)}
.card-h .dot{width:10px;height:10px;border-radius:50%;background:var(--gold);flex:none}
.card-b{padding:18px 20px;font-size:19px;line-height:1.72;color:var(--ink-2)}
.card-b p{margin-bottom:9px}
.card-b p:last-child{margin-bottom:0}
/* 条目多时收紧，避免溢出页面。
   ⚠️ 坑：`.ul.tight li` 自带 font-size，只改 .card-b 是压不下去的，必须连 li 一起收。 */
.card-b.dense{font-size:16px;line-height:1.52}
.card-b.dense .ul li,
.card-b.dense .ul.tight li{font-size:16px;line-height:1.52;margin-bottom:4px}
.card-b.dense .mini{font-size:15px;margin:9px 0 4px}
/* 正文条目多时改两栏：单栏塞不下会被 overflow:hidden 裁掉（静默丢内容），
   两栏能直接把所需高度减半，字号还保持可读。 */
.card-b.two-col{column-count:2;column-gap:34px}
.card-b.two-col p{break-inside:avoid}
/* 小标题：用于「🚉 交通节点」等分块 */
.card-b .mini{font-size:16.5px;font-weight:800;color:var(--gold-d);
  margin:12px 0 5px;padding-left:9px;border-left:3px solid var(--gold-l)}
.card-b .mini:first-child{margin-top:0}
.card.accent{border-left:6px solid var(--gold)}
.card.warn .card-h{background:#fbf1f1;color:var(--red)}
.card.warn .card-h .dot{background:var(--red)}
.card.green .card-h{background:#f1f5ee;color:var(--green)}
.card.green .card-h .dot{background:var(--green)}
/* ---------- 两栏 ---------- */
.cols{display:flex;gap:26px;height:100%}
.col-l{flex:0 0 42%;display:flex;flex-direction:column;gap:18px}
.col-r{flex:1;display:flex;flex-direction:column;gap:18px;min-width:0}
/* ---------- 地图 ---------- */
.figmap{background:#fff;border:1px solid var(--line);border-radius:16px;
  overflow:hidden;display:flex;flex-direction:column;flex:1;min-height:0}
.figmap-box{flex:1;min-height:0;display:flex;align-items:center;justify-content:center;
  background:#f7f5f2;padding:10px}
.figmap-box img{max-width:100%;max-height:100%;object-fit:contain;display:block}
.figmap-cap{font-size:17px;color:var(--muted);padding:11px 16px;background:#fcfaf7;
  border-top:1px solid var(--line);text-align:center}
/* ---------- 照片 ---------- */
.pgrid{display:grid;gap:12px;flex:1;min-height:0}
.pgrid.n1{grid-template-columns:1fr}
.pgrid.n3{grid-template-columns:1fr 1fr;grid-template-rows:1.35fr 1fr}
.pgrid.n3 .ph:first-child{grid-column:1 / span 2}
.pgrid.n4{grid-template-columns:1fr 1fr;grid-template-rows:1fr 1fr}
.ph{border-radius:12px;overflow:hidden;background:#eae6e0;min-height:0}
.ph img{width:100%;height:100%;object-fit:cover;display:block}
/* ---------- 列表 ---------- */
.ul{list-style:none}
.ul li{position:relative;padding-left:26px;margin-bottom:11px;font-size:19px;
  line-height:1.66;color:var(--ink-2)}
.ul li:last-child{margin-bottom:0}
.ul li::before{content:'';position:absolute;left:6px;top:12px;width:8px;height:8px;
  border-radius:50%;background:var(--gold-l)}
.ul.tight li{margin-bottom:8px;font-size:18px}
/* ---------- 时间轴（总行程） ---------- */
.tl{position:relative;padding-left:30px}
.tl-item{position:relative;padding:0 0 16px 22px;border-left:3px solid var(--gold-l)}
.tl-item:last-child{border-left-color:transparent;padding-bottom:0}
.tl-item::before{content:'';position:absolute;left:-10.5px;top:6px;width:18px;height:18px;
  border-radius:50%;background:var(--gold);border:4px solid var(--cream)}
.tl-day{font-size:19px;font-weight:800;color:var(--gold-d);letter-spacing:1px}
.tl-main{font-size:23px;font-weight:800;margin:2px 0 5px;color:var(--ink)}
.tl-chain{font-size:17.5px;color:var(--ink-2);line-height:1.62}
.tl-chain .arw{color:var(--gold);font-weight:800;padding:0 4px}
/* 总行程页专用：7 天要塞进一页，整体收紧 */
.ov .tl-item{padding:0 0 13px 20px}
.ov .tl-item::before{width:16px;height:16px;left:-9.5px;top:5px}
.ov .tl-day{font-size:18px}
.ov .tl-main{font-size:21px;margin:1px 0 4px}
.ov .tl-chain{font-size:17px;line-height:1.56}
/* ---------- 表格（预算） ---------- */
table{width:100%;border-collapse:collapse;font-size:19px}
th{background:var(--gold-bg);color:var(--ink);font-weight:800;text-align:left;
   padding:13px 15px;border-bottom:2px solid var(--gold-l);font-size:18px}
td{padding:12px 15px;border-bottom:1px solid var(--line);color:var(--ink-2);line-height:1.55}
tr:last-child td{border-bottom:none}
td.num{text-align:right;font-weight:800;color:var(--red);white-space:nowrap}
td.plain{text-align:right;white-space:nowrap}
/* ---------- 景点标题条 ---------- */
.spotbar{display:flex;align-items:center;gap:16px;padding:18px 24px;
  background:linear-gradient(180deg,#fff,#fdfbf8);border:1px solid var(--line);
  border-left:7px solid var(--red);border-radius:14px}
.spotbar .idx{font-size:19px;font-weight:800;color:#fff;background:var(--red);
  border-radius:50%;width:44px;height:44px;display:flex;align-items:center;
  justify-content:center;flex:none}
.spotbar .nm{font-size:31px;font-weight:800;color:var(--red);letter-spacing:.5px}
.spotbar .tag{margin-left:auto;font-size:17px;color:var(--gold-d);font-weight:700;
  letter-spacing:1.5px}
/* ---------- 预算合计 ---------- */
.tot{display:flex;gap:20px;margin-top:20px}
.tot-box{flex:1;background:var(--card);border:1px solid var(--line);border-radius:16px;
  padding:20px 24px;border-top:5px solid var(--gold)}
.tot-box .lb{font-size:19px;color:var(--muted);font-weight:700}
.tot-box .vl{font-size:46px;font-weight:800;color:var(--red);line-height:1.2;margin-top:4px}
.tot-box .sub{font-size:17px;color:var(--muted);margin-top:4px}
/* ---------- 物品清单 ---------- */
.pack{display:grid;grid-template-columns:repeat(7,1fr);gap:14px}
.pack-col{background:var(--card);border:1px solid var(--line);border-radius:14px;
  overflow:hidden;display:flex;flex-direction:column}
.pack-col .ph{background:var(--gold-bg);padding:11px 12px;font-size:19px;font-weight:800;
  color:var(--gold-d);text-align:center;border-bottom:1px solid var(--line)}
.pack-col ul{list-style:none;padding:12px 13px;font-size:16.5px;line-height:1.5;color:var(--ink-2)}
.pack-col ul li{padding:3px 0;border-bottom:1px dashed #f0eae2}
.pack-col ul li:last-child{border-bottom:none}
/* ---------- 出发前必看 ---------- */
.pf{display:flex;gap:24px;height:100%}
.pf-col{flex:1;display:flex;flex-direction:column;gap:18px}
.note-line{padding:14px 18px;border-radius:12px;font-size:19px;line-height:1.7;
  background:#fdfbf7;border-left:5px solid var(--gold);border:1px solid var(--line);
  border-left:5px solid var(--gold);color:var(--ink-2)}
.foot{position:absolute;left:60px;right:60px;bottom:16px;display:flex;
  justify-content:space-between;font-size:15px;color:var(--muted);
  border-top:1px solid var(--line);padding-top:9px}
